# Copie este arquivo para ".env" e ajuste os valores.
# O sistema funciona sem ele (usa os padrões abaixo); o arquivo serve para
# deixar as configurações registradas ou para rodar com Docker/systemd.

# Porta e interface do site
PORT=3000
HOST=0.0.0.0

# Pasta onde ficam banco, uploads e cache de imagens (backup = copiar esta pasta)
# LICITAPRO_DATA_DIR=/app/data

# Primeiro acesso criado automaticamente na primeira execução
LICITAPRO_ADMIN_NOME=Administrador
LICITAPRO_ADMIN_EMAIL=admin@licitapro.com.br
LICITAPRO_ADMIN_SENHA=troque-esta-senha

# Chave que assina os cookies de sessão (se não informar, é gerada em data/secret.key)
# LICITAPRO_SECRET=uma-chave-longa-e-aleatoria

# "0" desativa o cadastro de novos usuários pelo site (uso interno)
LICITAPRO_REGISTRO_ABERTO=1
